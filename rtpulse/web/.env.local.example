# Azure AD (Microsoft Entra ID) OAuth 설정
# Azure Portal > App Registrations 에서 확인
AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_AD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# NextAuth 설정
NEXTAUTH_URL=https://watch.example.com
# 랜덤 시크릿 생성: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rtpulse
DB_USER=rtpulse
DB_PASSWORD=

# NAS SSH 접속 정보
NAS_SSH_HOST=<NAS_IP>
NAS_SSH_PORT=22
NAS_SSH_USER=nasuser
NAS_SSH_PASSWORD=

# CSV → JSON 변환 서버 (PE-Core, feature 컬럼 없을 때만 필요)
# feature 컬럼이 있는 CSV는 브라우저에서 직접 변환하므로 미설정 가능
FEATURE_EXTRACTOR_URL=http://[Flask서버IP]:[포트]

# Teams COMPLAIN 채널 Incoming Webhook URL
# 설정 방법: Teams 채널 > ··· > 커넥터 > Incoming Webhook > 구성 > URL 복사
# 미설정 시 알림 기능이 조용히 비활성화됩니다
TEAMS_COMPLAIN_WEBHOOK_URL=https://xxxx.webhook.office.com/webhookb2/...

# --- 서버실 (Zabbix) ---
# Zabbix 프런트엔드 주소. /api_jsonrpc.php 는 붙이지 않는다.
ZABBIX_URL=http://<ZABBIX_SERVER_IP>
# 에이전트 Server= / ServerActive= 값 (lib/serverroom-register.ts)
ZABBIX_AGENT_ALLOW=<DEV_GPU01_IP>,<TSR_TAILNET_IP>,<ZABBIX_SERVER_IP>
ZABBIX_SERVER_ACTIVE=<ZABBIX_SERVER_IP>
# API 토큰 (Zabbix > 사용자 > API 토큰). 토큰이 없으면 아래 계정으로 대체된다.
ZABBIX_TOKEN=
# ZABBIX_USER=
# ZABBIX_PASS=

# --- 선택 기능 (미설정 시 해당 기능 비활성) ---
# 중앙 메트릭 (VictoriaMetrics / Grafana)
CENTRAL_METRICS_URL=http://localhost:8428
CENTRAL_GRAFANA_URL=http://localhost:3001
# 자산관리(IMS) DB — 납품현황 조회용
IMS_DB_HOST=
IMS_DB_PORT=5432
IMS_DB_NAME=ims
IMS_DB_USER=
IMS_DB_PASSWORD=
# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Notion (프롬프트 기록 / 릴리즈 노트 DB)
NOTION_API_KEY=
NOTION_PROMPT_DB_ID=
NOTION_DB_FE=
NOTION_DB_BE=
NOTION_DB_ES=
NOTION_DB_MEDIA=
NOTION_DB_BUNDLE=
# Gemini 오토 라벨링
GOOGLE_AI_STUDIO_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# APO(프롬프트 최적화) 백엔드
APO_BASE_URL=http://localhost:8000
# Azure DevOps 멤버 조회 (담당자 선택용)
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=
# Helpdesk(Chatwoot) 연동
HELPDESK_INGEST_TOKEN=
NEXT_PUBLIC_CHATWOOT_URL=
NEXT_PUBLIC_CHATWOOT_TOKEN=
TEAMS_ALERT_WEBHOOK_URL=
